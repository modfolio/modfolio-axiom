{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	// Fleet baseline (harness 3.16.6 biome-excludes adoption — cleanup only
	// patches biome.json, ported here manually for biome.jsonc): build output
	// and harness runtime artifacts are not lint targets. vcs.enabled alone
	// does not exclude untracked-but-present dist/ when running `biome check .`.
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			// Qwik SSR build output (gitignored via bare `server` in .gitignore)
			"!**/server",
			"!**/.output",
			"!**/.astro",
			"!**/.wrangler",
			"!**/worker-configuration.d.ts",
			"!.claude/app-registry.json",
			"!.claude/payment-approval.json",
			"!**/migrations"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			},
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			}
		},
		{
			// Test modules are plain Bun test files, never Qwik QRLs/components, so
			// the auto-enabled qwik-domain serializability rule (triggered merely by
			// @builder.io/qwik being a dependency) is a false positive here. Scope it
			// off for tests rather than wrapping non-Qwik helpers in $() or suppressing
			// inline — the rule simply does not apply to this file class.
			"includes": ["**/*.test.ts", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"useQwikValidLexicalScope": "off"
					}
				}
			}
		}
	]
}
