---
import Base from "~/layouts/Base.astro";
import Header from "~/components/landing/Header.astro";
import Footer from "~/components/landing/Footer.astro";
---

<Base
	title="Contact — Modfolio Axiom"
	description="Modfolio Axiom 연락처. 이메일, 주소, 사업자 정보."
>
	<Header />
	<main id="main">
		<section class="contact-hero">
			<span class="contact-hero__label">Contact</span>
			<h1 class="contact-hero__title">Get in Touch</h1>
			<p class="contact-hero__subtitle">
				프로젝트 협업, 기술 문의, 또는 Axiom에 대해 알고 싶은 것이
				있다면 연락해 주세요.
			</p>
		</section>

		<section class="contact-info">
			<div class="contact-info__inner">
				<span class="section-label">Contact Information</span>
				<div class="contact-info__grid">
					<div class="info-card">
						<div class="info-card__icon" aria-hidden="true">
							<svg
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect
									x="2"
									y="4"
									width="20"
									height="16"
									rx="2"></rect>
								<path
									d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
								></path>
							</svg>
						</div>
						<h3 class="info-card__title">Email</h3>
						<a
							href="mailto:contact@modfolio.io"
							class="info-card__value"
							>contact@modfolio.io</a
						>
					</div>

					<div class="info-card">
						<div class="info-card__icon" aria-hidden="true">
							<svg
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
								></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
						</div>
						<h3 class="info-card__title">Address</h3>
						<p class="info-card__value">
							경기도 수원시 팔달구 효원로 278, 6층 602호
						</p>
					</div>

					<div class="info-card">
						<div class="info-card__icon" aria-hidden="true">
							<svg
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"
								></path>
								<path d="M13.73 21a2 2 0 0 1-3.46 0"
								></path>
							</svg>
						</div>
						<h3 class="info-card__title">Social</h3>
						<div class="info-card__links">
							<a
								href="https://instagram.com/modfolio.io"
								target="_blank"
								rel="noopener">Instagram</a
							>
							<a
								href="https://linkedin.com/company/modfolio"
								target="_blank"
								rel="noopener">LinkedIn</a
							>
							<a
								href="https://youtube.com/@modfolio"
								target="_blank"
								rel="noopener">YouTube</a
							>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="contact-business">
			<div class="contact-business__inner">
				<span class="section-label">Business Information</span>
				<div class="contact-business__content">
					<dl class="contact-business__list">
						<div class="contact-business__item">
							<dt>상호</dt>
							<dd>모드폴리오</dd>
						</div>
						<div class="contact-business__item">
							<dt>대표</dt>
							<dd>김동헌</dd>
						</div>
						<div class="contact-business__item">
							<dt>사업자등록번호</dt>
							<dd>104-95-65636</dd>
						</div>
						<div class="contact-business__item">
							<dt>통신판매업</dt>
							<dd>제2025-수원팔달-0953호</dd>
						</div>
						<div class="contact-business__item">
							<dt>출판사 등록</dt>
							<dd>제2024-000037호</dd>
						</div>
						<div class="contact-business__item">
							<dt>소재지</dt>
							<dd>
								경기도 수원시 팔달구 효원로 278, 6층
								602호
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<section class="contact-cta">
			<a
				href="https://nexus.modfolio.io"
				class="btn btn--primary btn--lg">Explore Portal</a
			>
		</section>
	</main>
	<Footer />
</Base>

<style>
	/* ── Hero ── */
	.contact-hero {
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: 80px;
		padding-inline: clamp(1rem, 4vw, 2rem);
	}

	.contact-hero__label {
		font-family: var(--font-code);
		font-size: var(--text-sm);
		color: var(--color-text-tertiary);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		margin-bottom: var(--space-5);
	}

	.contact-hero__title {
		font-family: var(--font-display);
		font-size: var(--text-4xl);
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		background: var(--accent-gradient-text);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: var(--space-5);
	}

	.contact-hero__subtitle {
		font-family: var(--font-ui);
		font-size: var(--text-lg);
		color: var(--color-text-tertiary);
		line-height: var(--leading-normal);
		max-width: var(--measure);
	}

	/* ── Info Cards ── */
	.contact-info {
		padding-block: var(--space-12);
		padding-inline: clamp(1rem, 4vw, 2rem);
		position: relative;
	}

	.contact-info::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--color-border-default) 20%,
			var(--color-border-accent) 50%,
			var(--color-border-default) 80%,
			transparent
		);
	}

	.contact-info__inner {
		max-width: var(--content-max-width);
		margin-inline: auto;
	}

	.contact-info__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-5);
	}

	.info-card {
		background: var(--card-bg);
		border: var(--card-border);
		border-radius: var(--card-radius);
		padding: var(--card-padding);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		transition:
			border-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	.info-card:hover {
		border-color: var(--color-border-accent);
		box-shadow: var(--shadow-glow);
	}

	.info-card__icon {
		color: var(--color-text-accent);
		margin-bottom: var(--space-2);
	}

	.info-card__title {
		font-family: var(--font-ui);
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-tertiary);
	}

	.info-card__value {
		font-family: var(--font-ui);
		font-size: var(--text-base);
		color: var(--color-text-primary);
		line-height: var(--leading-relaxed);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	a.info-card__value:hover {
		color: var(--color-text-accent);
	}

	.info-card__links {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.info-card__links a {
		font-family: var(--font-ui);
		font-size: var(--text-base);
		color: var(--color-text-primary);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.info-card__links a:hover {
		color: var(--color-text-accent);
	}

	/* ── Business Info ── */
	.contact-business {
		padding-block: var(--space-12);
		padding-inline: clamp(1rem, 4vw, 2rem);
		position: relative;
	}

	.contact-business::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--color-border-default) 20%,
			var(--color-border-accent) 50%,
			var(--color-border-default) 80%,
			transparent
		);
	}

	.contact-business__inner {
		max-width: var(--content-max-width);
		margin-inline: auto;
	}

	.contact-business__list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-5);
	}

	.contact-business__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.contact-business__item dt {
		font-family: var(--font-ui);
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-tertiary);
	}

	.contact-business__item dd {
		font-family: var(--font-ui);
		font-size: var(--text-base);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	/* ── CTA ── */
	.contact-cta {
		text-align: center;
		padding-block: var(--space-12);
		padding-inline: clamp(1rem, 4vw, 2rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
	}

	.contact-cta::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--color-border-default) 20%,
			var(--color-border-accent) 50%,
			var(--color-border-default) 80%,
			transparent
		);
	}

	/* ── Responsive ── */
	@media (max-width: 768px) {
		.contact-info__grid {
			grid-template-columns: 1fr;
		}

		.contact-business__list {
			grid-template-columns: 1fr;
		}
	}
</style>
