---
import Base from "~/layouts/Base.astro";
import Header from "~/components/landing/Header.astro";
import Footer from "~/components/landing/Footer.astro";
import DomainPage from "~/components/landing/DomainPage.astro";
---

<Base
	title="Deep Tech — Modfolio Axiom"
	description="Incubation programs, frontier technology, and applied innovation. 프론티어 기술과 응용 혁신."
>
	<Header />
	<main id="main">
		<DomainPage
			title="Deep Tech"
			number="06"
			subtitle="Incubation programs, frontier technology, applied innovation"
			description={`프론티어 기술과 응용 혁신은 Axiom의 미래를 정의합니다. Deep Tech 도메인은 아직 시장에서 검증되지 않았지만 근본적인 변화를 일으킬 수 있는 기술을 탐구하고, 이를 실제 제품으로 전환하는 과정을 지원합니다.

딥테크 인큐베이션 프로그램을 통해 초기 단계의 기술 아이디어를 체계적으로 검증하고 발전시킵니다. 기술 실사, 프로토타이핑, 시장 검증, 스케일링까지의 전 과정에서 기술적 멘토링과 인프라 지원을 제공합니다. Modfolio 생태계의 자원을 활용하여 독립적인 개발이 어려운 기술적 도전을 함께 해결합니다.

기술 이전과 지식재산 개발은 Deep Tech의 핵심 활동입니다. 연구 결과를 실용적인 기술로 변환하고, 특허와 라이선스를 통해 기술적 가치를 보호합니다. 각 자회사 앱에서 축적된 기술적 성과를 체계화하여 새로운 응용 가능성을 모색합니다.`}
			capabilities={[
				{
					title: "Technology Incubation",
					desc: "초기 기술 아이디어의 체계적 검증. 프로토타이핑, 기술 실사, PoC 개발을 위한 통합 지원 프로그램.",
				},
				{
					title: "Frontier Research",
					desc: "Edge AI, 분산 컴퓨팅, 새로운 프로토콜 탐구. 현재 기술의 한계를 넘어서는 실험적 연구.",
				},
				{
					title: "Applied Innovation",
					desc: "연구 결과의 제품화. 기술적 발견을 실제 사용자 가치로 전환하는 체계적 프로세스.",
				},
				{
					title: "IP Development",
					desc: "특허 포트폴리오 구축, 기술 라이선싱, 지식재산 전략. 기술적 가치의 체계적 보호와 활용.",
				},
			]}
			relatedProducts={[
				{
					name: "KeepNBuild",
					url: "https://keepnbuild.com",
					desc: "맞춤 여행 설계 앱. 사용자 주도형 일정 빌더와 스마트 추천 엔진.",
				},
				{
					name: "Worthee",
					url: "https://worthee.io",
					desc: "셀프 관리 앱. 목표 설정, 습관 추적, 데이터 기반 자기 관리 시스템.",
				},
			]}
		/>
	</main>
	<Footer />
</Base>
