<!-- Showcase Section — Amberstella terminal mockup, badge-based -->
<section class="showcase" id="showcase">
	<div class="showcase__inner">
		<span class="section-label">Product</span>
		<div class="showcase__card">
			<div class="showcase__layout">
				<div class="showcase__info">
					<div class="showcase__badges">
						<span class="badge badge--amber">Shuttle Tracking</span>
						<span class="badge badge--amber">Landing</span>
					</div>
					<h2 class="showcase__name">Amberstella</h2>
					<p class="showcase__desc">
						실시간 셔틀 위치 추적과 탑승 관리. Durable Objects 기반의 실시간
						데이터로 정확한 도착 시간을 전달합니다.
					</p>
					<code class="showcase__domain">amberstella.com</code>
				</div>
				<div class="showcase__terminal" aria-hidden="true">
					<div class="terminal__bar">
						<span class="terminal__dot terminal__dot--red"></span>
						<span class="terminal__dot terminal__dot--yellow"></span>
						<span class="terminal__dot terminal__dot--green"></span>
					</div>
					<div class="terminal__body">
						<code class="terminal__line terminal__line--prompt"
							>$ shuttle.status --id AS-7201</code
						>
						<code class="terminal__line"
							>&gt; position: 37.5665&deg;N, 126.9780&deg;E</code
						>
						<code class="terminal__line">&gt; eta: 3m 22s</code>
						<code class="terminal__line">&gt; passengers: 12/28</code>
						<code class="terminal__line">
							&gt; status: en_route
							<span class="terminal__cursor">&#9608;</span>
						</code>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
