		margin-inline: auto;
	}

	.showcase__card {
		background: var(--card-bg);
		border: var(--card-border);
		border-radius: var(--card-radius);
		overflow: hidden;
		box-shadow: var(--shadow-2);
	}

	.showcase__layout {
