{
	"name": "modfolio-axiom",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"packageManager": "bun@1.4.2",
	"overrides": {
		"esbuild": "0.27.4",
		"@biomejs/cli-linux-x64-musl": "npm:@biomejs/cli-linux-x64@2.5.12",
		"sharp": "0.35.4",
		"yaml": "2.8.3"
	},
	"scripts": {
		"dev": "cd apps/app && bun run dev",
		"dev:landing": "cd apps/landing && bun run dev",
		"build": "cd apps/landing && bun run build && cd ../../apps/app && bun run build",
		"build:landing": "cd apps/landing && bun run build",
		"build:app": "cd apps/app && bun run build",
		"check": "cd apps/app && bun run check && cd ../../apps/landing && bun run check",
		"typecheck": "cd apps/app && bun run typecheck && cd ../../apps/landing && bun run typecheck",
		"test": "cd apps/app && bun run test",
		"quality:all": "bun run check && bun run typecheck && bun run test",
		"lint": "cd apps/app && bun run lint",
		"format": "cd apps/app && bun run format",
		"harness-pull": "modfolio-harness-pull",
		"modfolio": "modfolio-check",
		"json-diff": "bun node_modules/@modfolio/harness/scripts/json-diff.ts",
		"check:audit": "bun node_modules/@modfolio/harness/scripts/check-audit.ts",
		"ts7:ready": "bun node_modules/@modfolio/harness/scripts/ci/ts7-readiness.ts",
		"verify:frozen-lockfile": "bun node_modules/@modfolio/harness/scripts/ci/frozen-lockfile.ts",
		"verify:no-nul": "bun node_modules/@modfolio/harness/scripts/ci/no-nul-bytes.ts",
		"heavy": "bash node_modules/@modfolio/harness/scripts/ops/heavy.sh",
		"verify:supply-chain": "bun node_modules/@modfolio/harness/scripts/ci/supply-chain-gate.ts",
		"atlas:adopt-plainly": "bun node_modules/@modfolio/harness/scripts/atlas/adopt-plainly.ts",
		"verify:bunx-leak": "bun node_modules/@modfolio/harness/scripts/ci/bunx-leak-gate.ts",
		"modfolio:compass": "bun node_modules/@modfolio/harness/scripts/modfolio/compass.ts",
		"modfolio:nonstop": "bun node_modules/@modfolio/harness/scripts/ops/modfolio-nonstop.ts",
		"verify:gates": "bun node_modules/@modfolio/harness/scripts/ci/gates-run.ts",
		"gate:quick": "bun node_modules/@modfolio/harness/scripts/ci/gate-run.ts quick",
		"gate:full": "bun node_modules/@modfolio/harness/scripts/ci/gate-run.ts full",
		"gate:release": "bun node_modules/@modfolio/harness/scripts/ci/gate-run.ts release",
		"gate:weekly": "bun node_modules/@modfolio/harness/scripts/ci/gate-run.ts weekly",
		"verify:gate-tiers": "bun node_modules/@modfolio/harness/scripts/ci/gate-run.ts --audit",
		"feedback-send": "bun node_modules/@modfolio/harness/scripts/feedback-send.ts",
		"debrief:curate": "bun node_modules/@modfolio/harness/scripts/debrief/curate.ts",
		"handoff:prepare:apply": "bash node_modules/@modfolio/harness/scripts/ops/handoff-prepare.sh --apply-commit-push",
		"handoff:restore": "bash node_modules/@modfolio/harness/scripts/ops/handoff-restore.sh",
		"review:packet": "bun node_modules/@modfolio/harness/scripts/review/packet.ts",
		"modfolio:sun": "bun node_modules/@modfolio/harness/scripts/modfolio/sun.ts",
		"modfolio:moon": "bun node_modules/@modfolio/harness/scripts/modfolio/moon.ts",
		"modfolio:effort": "bun node_modules/@modfolio/harness/scripts/modfolio/effort.ts",
		"review:run": "bun node_modules/@modfolio/harness/scripts/review/run.ts",
		"ai:google": "bun node_modules/@modfolio/harness/scripts/review/google.ts",
		"ai:suggest": "bun node_modules/@modfolio/harness/scripts/budget/suggest.ts",
		"modfolio:install-guards": "bun node_modules/@modfolio/harness/scripts/modfolio/install-guards.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@modfolio/harness": "^3.94.3"
	},
	"dependencies": {
		"@modfolio/connect-sdk": "^10.13.0",
		"@modfolio/contracts": "^1.28.0"
	}
}
