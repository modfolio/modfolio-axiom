---
import Base from "~/layouts/Base.astro";
import Header from "~/components/landing/Header.astro";
import Footer from "~/components/landing/Footer.astro";
import DomainPage from "~/components/landing/DomainPage.astro";
---

<Base
	title="Engineering — Modfolio Axiom"
	description="Infrastructure systems, edge computing, and platform architecture. Axiom의 기술적 근간."
>
	<Header />
	<main id="main">
		<DomainPage
			title="Engineering"
			number="01"
			subtitle="Infrastructure systems, edge computing, platform architecture"
			description={`엔지니어링은 Axiom의 기술적 근간입니다. Cloudflare Edge 위에서 구축된 인프라는 전 세계 어디서든 동일한 성능을 보장합니다. 글로벌 엣지 네트워크를 기반으로 한 아키텍처는 사용자에게 가장 가까운 위치에서 연산을 수행하여, 레이턴시를 최소화하고 가용성을 극대화합니다.

플랫폼 아키텍처부터 분산 시스템 설계까지, 모든 자회사 앱의 기술적 토대를 설계하고 운영합니다. 각 앱은 독립적인 기술 스택을 유지하면서도 일관된 배포 파이프라인과 관찰 가능성 체계를 공유합니다.

Axiom Engineering은 단순한 인프라 운영을 넘어, 엣지 컴퓨팅의 한계를 탐구하고 새로운 패턴을 정립하는 연구 조직입니다. Durable Objects를 활용한 실시간 상태 관리, Workers 기반의 서버리스 연산, D1과 R2를 결합한 데이터 계층 등 Cloudflare 플랫폼의 가능성을 극한까지 끌어올립니다.`}
			capabilities={[
				{
					title: "Edge Computing",
					desc: "100% Cloudflare Workers + Pages. Zero cold start, 글로벌 엣지 배포. 300+ 도시에서 즉시 응답.",
				},
				{
					title: "Platform Architecture",
					desc: "마이크로서비스가 아닌 독립 앱 아키텍처. House of Brands 원칙에 따라 각 앱은 완전한 자율성을 보장받습니다.",
				},
				{
					title: "Real-time Systems",
					desc: "Durable Objects 기반 실시간 상태 관리와 WebSocket 인프라. 셔틀 추적, 라이브 협업 등 저지연 시스템 구축.",
				},
				{
					title: "Observability",
					desc: "OTLP 기반 분산 추적과 로깅. SigNoz 통합 모니터링으로 전체 생태계의 건강 상태를 실시간으로 파악합니다.",
				},
			]}
			relatedProducts={[
				{
					name: "Amberstella",
					url: "https://amberstella.com",
					desc: "실시간 셔틀 추적 시스템. Durable Objects + WebSocket 기반 라이브 위치 추적.",
				},
			]}
		/>
	</main>
	<Footer />
</Base>
