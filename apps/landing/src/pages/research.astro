---
import Base from "~/layouts/Base.astro";
import Header from "~/components/landing/Header.astro";
import Footer from "~/components/landing/Footer.astro";
import DomainPage from "~/components/landing/DomainPage.astro";
---

<Base
	title="Research — Modfolio Axiom"
	description="R&D methodology, experimental design, and peer collaboration. 연구개발 방법론과 협업 도구."
>
	<Header />
	<main id="main">
		<DomainPage
			title="Research"
			number="04"
			subtitle="R&D methodology, experimental design, peer collaboration"
			description={`연구개발 방법론과 실험 설계는 모든 과학적 진보의 기초입니다. Axiom Research는 체계적인 R&D 프로세스를 디지털 도구로 지원하여, 연구자들이 가설 수립부터 검증까지의 전 과정을 효율적으로 수행할 수 있도록 합니다.

연구자 간 협업은 현대 과학의 핵심 동력입니다. 문서 공유, 실시간 코멘트, 버전 관리, 피어 리뷰 워크플로우 등 연구 협업에 필요한 모든 도구를 하나의 플랫폼에서 제공합니다. 지리적 제약 없이 전 세계 연구자들과 실시간으로 협력할 수 있는 환경을 구축합니다.

리서치 워크플로우의 자동화와 표준화를 통해 반복적인 작업을 최소화하고, 연구자들이 창의적 사고에 집중할 수 있는 환경을 만듭니다. 문헌 검색, 데이터 수집, 통계 분석, 논문 작성까지 연구의 전 생애주기를 지원하는 통합 플랫폼을 지향합니다.`}
			capabilities={[
				{
					title: "Experimental Design",
					desc: "가설 수립, 실험 프로토콜 설계, 변수 통제. 체계적인 실험 설계 도구와 템플릿 시스템.",
				},
				{
					title: "Peer Collaboration",
					desc: "실시간 문서 공동 편집, 코멘트 스레드, 리뷰 워크플로우. 비동기 및 동기 협업 모두 지원.",
				},
				{
					title: "Research Workflows",
					desc: "문헌 검색부터 데이터 분석, 논문 작성까지. 연구 단계별 자동화된 워크플로우와 진행 추적.",
				},
				{
					title: "Publication Tools",
					desc: "학술 논문 포맷팅, 인용 관리, 저널 투고 지원. 다양한 출판 형식으로의 자동 변환.",
				},
			]}
			relatedProducts={[
				{
					name: "Munseo",
					url: "https://munseo.io",
					desc: "문서 변환/관리 유틸리티. 다양한 문서 형식 간 고품질 변환 엔진.",
				},
			]}
		/>
	</main>
	<Footer />
</Base>
