{
	"name": "@modfolio-axiom/app",
	"type": "module",
	"scripts": {
		"dev": "vite --mode ssr",
		"build": "qwik build",
		"build.client": "vite build",
		"build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
		"preview": "athsra run modfolio-axiom -- vite preview",
		"check": "biome check src/",
		"typecheck": "tsc --noEmit",
		"test": "bun test src/",
		"lint": "biome lint src/",
		"format": "biome format --write src/"
	},
	"dependencies": {
		"@builder.io/qwik": "^1.20.0",
		"@builder.io/qwik-city": "^1.20.0",
		"@modfolio/connect-sdk": "^8.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/bun": "^1.3.14",
		"ignore": "^7.0.5",
		"typescript": "^6.0.3",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^5.1.0"
	}
}
