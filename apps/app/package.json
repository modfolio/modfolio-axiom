{
  "name": "@modfolio-axiom/app",
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "preview": "athsra run modfolio-axiom -- vite preview",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.19.0",
    "@builder.io/qwik-city": "^1.19.0",
    "@modfolio/connect-sdk": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "ignore": "^7.0.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
