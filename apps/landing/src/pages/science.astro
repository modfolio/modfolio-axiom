---
import Base from "~/layouts/Base.astro";
import Header from "~/components/landing/Header.astro";
import Footer from "~/components/landing/Footer.astro";
import DomainPage from "~/components/landing/DomainPage.astro";
---

<Base
	title="Science — Modfolio Axiom"
	description="Computational research, data modeling, and analytical frameworks. 데이터 사이언스와 연산 연구."
>
	<Header />
	<main id="main">
		<DomainPage
			title="Science"
			number="02"
			subtitle="Computational research, data modeling, analytical frameworks"
			description={`데이터 사이언스와 연산 연구는 Axiom이 추구하는 응용 과학의 핵심입니다. 대규모 데이터 분석부터 AI/ML 파이프라인 구축까지, 과학적 방법론에 기반한 기술적 접근을 통해 실질적인 가치를 창출합니다.

자연어 처리, 음성 인식, 텍스트 분석 등 다양한 AI 모델을 Edge 환경에서 효율적으로 운용하는 방법을 연구합니다. 멀티 프로바이더 폴백 라우팅, 프롬프트 캐싱, 비용 최적화 등 프로덕션 레벨의 AI 인프라를 설계하고 운영합니다.

Axiom Science는 학술적 연구와 산업적 응용의 교차점에 위치합니다. pgvector를 활용한 벡터 검색, 실시간 데이터 스트리밍, 대규모 배치 처리 등 데이터 중심 아키텍처의 최신 패턴을 탐구하고 자회사 앱에 적용합니다.`}
			capabilities={[
				{
					title: "Data Modeling",
					desc: "Drizzle ORM 기반 타입 안전 데이터 모델링. Neon Postgres + pgvector로 구조화된 데이터와 벡터 검색을 통합.",
				},
				{
					title: "AI/ML Pipelines",
					desc: "멀티 프로바이더 AI 모델 라우터. 태스크별 자동 라우팅, 폴백 체인, 프롬프트 캐싱으로 비용과 성능을 최적화.",
				},
				{
					title: "Analytical Frameworks",
					desc: "사용자 행동 분석, A/B 테스팅, 코호트 분석 등 데이터 기반 의사결정을 위한 프레임워크 구축.",
				},
				{
					title: "Research Computing",
					desc: "Edge Workers 기반 분산 연산. 대규모 병렬 처리와 실시간 스트리밍 분석을 서버리스 환경에서 구현.",
				},
			]}
			relatedProducts={[
				{
					name: "GistCore",
					url: "https://gistcore.com",
					desc: "AI 스피킹 연습 앱. 음성 인식 + NLP 기반 실시간 피드백 시스템.",
				},
				{
					name: "Fortiscribe",
					url: "https://fortiscribe.com",
					desc: "AI 작문 첨삭 앱. 텍스트 분석 + 문법 교정 + 스타일 제안 파이프라인.",
				},
			]}
		/>
	</main>
	<Footer />
</Base>
