---
import Base from "~/layouts/Base.astro";
import Footer from "~/components/landing/Footer.astro";
import Header from "~/components/landing/Header.astro";
---

<Base
	title="404 — Modfolio Axiom"
	description="요청하신 페이지를 찾을 수 없습니다."
>
	<Header />
	<main id="main">
		<section class="notfound">
			<span class="notfound__code">404</span>
			<h1 class="notfound__title">페이지를 찾을 수 없습니다</h1>
			<p class="notfound__desc">
				요청하신 주소가 변경되었거나 더 이상 존재하지 않습니다.
			</p>
			<div class="notfound__actions">
				<a href="/" class="btn btn--primary btn--lg">홈으로 돌아가기</a>
				<a href="https://nexus.modfolio.io" class="btn btn--ghost btn--lg">포털 바로가기</a>
			</div>
		</section>
		<Footer />
	</main>
</Base>

<style>
	.notfound {
		max-width: var(--content-max-width);
		margin: 0 auto;
		padding: var(--space-11) var(--space-6) var(--space-10);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-4);
		min-height: 60dvh;
		justify-content: center;
	}

	.notfound__code {
		font-family: var(--font-code);
		font-size: clamp(3rem, 2rem + 6vw, 6rem);
		font-weight: 700;
		line-height: 1;
		color: var(--color-interactive-primary);
		letter-spacing: var(--tracking-tight);
	}

	.notfound__title {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--color-text-primary);
		letter-spacing: var(--tracking-tight);
	}

	.notfound__desc {
		font-family: var(--font-body);
		font-size: var(--text-base);
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		max-width: 42ch;
	}

	.notfound__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		justify-content: center;
		margin-top: var(--space-4);
	}
</style>
