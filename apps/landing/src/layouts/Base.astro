---
interface Props {
	title?: string;
	description?: string;
}
const { title = "Modfolio Axiom", description = "Applied Science & Engineering" } = Astro.props;
// Path-aware canonical: each page is canonical to its own URL, not the homepage.
// `Astro.url.pathname` keeps /contact distinct from / for canonical + og:url.
const SITE = "https://axiom.modfolio.io";
const canonicalUrl = new URL(Astro.url.pathname, SITE).href;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0a0a14" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="ko_KR" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="preconnect" href="https://use.typekit.net" crossorigin />
		<link rel="stylesheet" href="https://use.typekit.net/fmh4fod.css" />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">본문으로 건너뛰기</a>
		<slot />
		<div class="grain-overlay" aria-hidden="true"></div>
	</body>
</html>

<style is:global>
	@import "../styles/global.css";
</style>
