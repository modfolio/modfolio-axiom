{
  "name": "@modfolio-axiom/landing",
  "type": "module",
  "scripts": {
    "dev": "athsra run modfolio-axiom -- astro dev",
    "build": "astro build",
    "preview": "athsra run modfolio-axiom -- astro preview",
    "deploy": "astro build && athsra run modfolio-connect -- wrangler deploy",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "typecheck:astro": "astro check",
    "lint": "biome lint src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.2",
    "@modfolio/connect-sdk": "^8.2.1",
    "astro": "^7.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.106.0"
  }
}
