{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"jsxImportSource": "@builder.io/qwik",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"incremental": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
